{
  "name": "mindcraft-v2",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "emulator": "node ./apps/mobile/scripts/android.mjs emulator",
    "android:emulator": "node ./apps/mobile/scripts/android.mjs build",
    "start": "node ./apps/mobile/scripts/android.mjs start",
    "dev": "node ./apps/mobile/scripts/android.mjs start",
    "test": "pnpm --filter @mindcraft/game-rules test && pnpm --filter @mindcraft/schedule test && pnpm --filter @mindcraft/sprites test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
